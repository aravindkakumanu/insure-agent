# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it contains secrets.

OPENAI_API_KEY=sk-...your-key-here...

# Optional: LangSmith tracing. OFF unless LANGSMITH_TRACING=true.
# When on, every /ask is traced end to end: the router decision, which agents ran,
# each tool call with its query and how many chunks came back, token counts, and
# latency per step. Get a key at smith.langchain.com. Restart the server after
# changing it (the setting is read once per process).
# PRIVACY: a trace contains the user's question, the rewritten questions, the
# answer (PII-scrubbed) and the retrieved policy text, and is sent to LangSmith.
# Leave this off wherever that is not acceptable. The test suite forces it off.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...your-key-here...
# LANGSMITH_PROJECT=insure-agent
# EU workspaces only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Where conversation sessions are stored (SQLite). Optional; the default is shown.
# Sessions survive restarts. The file holds the questions as the agents received
# them and the models' answers before output scrubbing, is created readable by you only, and is never
# cleaned up automatically. Treat it as sensitive; delete it to forget everything.
# SESSIONS_DB=data/sessions.db
